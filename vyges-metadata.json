  "interfaces": [
    {
      "type": "clock",
      "direction": "input",
      "protocol": "Single-ended",
      "signals": [
        { "name": "clk_i", "direction": "input", "width": 1, "description": "System clock input" }
      ]
    },
    {
      "type": "reset",
      "direction": "input",
      "protocol": "Active-low",
      "signals": [
        { "name": "reset_n_i", "direction": "input", "width": 1, "description": "Active-low reset signal" }
      ]
    },
    {
      "type": "axi4_stream",
      "direction": "input",
      "protocol": "AXI4-Stream",
      "signals": [
        { "name": "s_axis_tdata_i", "direction": "input", "width": "VECTOR_WIDTH*DATA_WIDTH", "description": "Input vector data" },
        { "name": "s_axis_tvalid_i", "direction": "input", "width": 1, "description": "Input data valid" },
        { "name": "s_axis_tready_o", "direction": "output", "width": 1, "description": "Input ready" },
        { "name": "s_axis_tlast_i", "direction": "input", "width": 1, "description": "Input last signal" }
      ]
    },
    {
      "type": "axi4_stream",
      "direction": "output",
      "protocol": "AXI4-Stream",
      "signals": [
        { "name": "m_axis_tdata_o", "direction": "output", "width": "CODEBOOK_INDEX_WIDTH", "description": "Output codebook index (quantization) or reconstructed vector (dequantization)" },
        { "name": "m_axis_tvalid_o", "direction": "output", "width": 1, "description": "Output data valid" },
        { "name": "m_axis_tready_i", "direction": "input", "width": 1, "description": "Output ready" },
        { "name": "m_axis_tlast_o", "direction": "output", "width": 1, "description": "Output last signal" }
      ]
    },
    {
      "type": "axi4_lite",
      "direction": "input",
      "protocol": "AXI4-Lite",
      "signals": [
        { "name": "s_axi_awaddr_i", "direction": "input", "width": "ADDR_WIDTH", "description": "Write address" },
        { "name": "s_axi_awvalid_i", "direction": "input", "width": 1, "description": "Write address valid" },
        { "name": "s_axi_awready_o", "direction": "output", "width": 1, "description": "Write address ready" },
        { "name": "s_axi_wdata_i", "direction": "input", "width": 32, "description": "Write data" },
        { "name": "s_axi_wstrb_i", "direction": "input", "width": 4, "description": "Write strobe" },
        { "name": "s_axi_wvalid_i", "direction": "input", "width": 1, "description": "Write data valid" },
        { "name": "s_axi_wready_o", "direction": "output", "width": 1, "description": "Write data ready" },
        { "name": "s_axi_bresp_o", "direction": "output", "width": 2, "description": "Write response" },
        { "name": "s_axi_bvalid_o", "direction": "output", "width": 1, "description": "Write response valid" },
        { "name": "s_axi_bready_i", "direction": "input", "width": 1, "description": "Write response ready" },
        { "name": "s_axi_araddr_i", "direction": "input", "width": "ADDR_WIDTH", "description": "Read address" },
        { "name": "s_axi_arvalid_i", "direction": "input", "width": 1, "description": "Read address valid" },
        { "name": "s_axi_arready_o", "direction": "output", "width": 1, "description": "Read address ready" },
        { "name": "s_axi_rdata_o", "direction": "output", "width": 32, "description": "Read data" },
        { "name": "s_axi_rresp_o", "direction": "output", "width": 2, "description": "Read response" },
        { "name": "s_axi_rvalid_o", "direction": "output", "width": 1, "description": "Read data valid" },
        { "name": "s_axi_rready_i", "direction": "input", "width": 1, "description": "Read data ready" }
      ]
    },
    {
      "type": "control",
      "direction": "input",
      "protocol": "Standard",
      "signals": [
        { "name": "mode_i", "direction": "input", "width": 1, "description": "0=Quantization, 1=Dequantization" },
        { "name": "start_i", "direction": "input", "width": 1, "description": "Start operation" },
        { "name": "clear_i", "direction": "input", "width": 1, "description": "Clear operation" }
      ]
    },
    {
      "type": "status",
      "direction": "output",
      "protocol": "Standard",
      "signals": [
        { "name": "busy_o", "direction": "output", "width": 1, "description": "Module busy" },
        { "name": "done_o", "direction": "output", "width": 1, "description": "Operation complete" },
        { "name": "error_o", "direction": "output", "width": 1, "description": "Error flag" }
      ]
    },
    {
      "type": "chiplet_interface",
      "direction": "bidirectional",
      "protocol": "UCIe",
      "signals": [
        { "name": "chiplet_clk_i", "direction": "input", "width": 1, "description": "Chiplet interface clock" },
        { "name": "chiplet_reset_n_i", "direction": "input", "width": 1, "description": "Chiplet interface reset" },
        { "name": "chiplet_tx_data_o", "direction": "output", "width": 64, "description": "Transmit data to other chiplets" },
        { "name": "chiplet_tx_valid_o", "direction": "output", "width": 1, "description": "Transmit data valid" },
        { "name": "chiplet_tx_ready_i", "direction": "input", "width": 1, "description": "Transmit ready from other chiplets" },
        { "name": "chiplet_rx_data_i", "direction": "input", "width": 64, "description": "Receive data from other chiplets" },
        { "name": "chiplet_rx_valid_i", "direction": "input", "width": 1, "description": "Receive data valid" },
        { "name": "chiplet_rx_ready_o", "direction": "output", "width": 1, "description": "Receive ready to other chiplets" }
      ]
    },
    {
      "type": "power_management",
      "direction": "bidirectional",
      "protocol": "Standard",
      "signals": [
        { "name": "power_enable_i", "direction": "input", "width": 1, "description": "Power enable signal" },
        { "name": "sleep_mode_i", "direction": "input", "width": 1, "description": "Sleep mode control" },
        { "name": "power_status_o", "direction": "output", "width": 2, "description": "Power status (00=off, 01=standby, 10=active, 11=error)" },
        { "name": "thermal_status_o", "direction": "output", "width": 4, "description": "Thermal status and temperature encoding" }
      ]
    }
  ],
  "parameters": [
    {
      "name": "VECTOR_WIDTH",
      "type": "int",
      "default": 16,
      "description": "Number of elements in input vector",
      "range": { "min": 8, "max": 64 },
      "units": "elements",
      "required": false
    },
    {
      "name": "DATA_WIDTH",
      "type": "int",
      "default": 16,
      "description": "Bit width of each vector element (fixed-point)",
      "range": { "min": 8, "max": 32 },
      "units": "bits",
      "required": false
    },
    {
      "name": "CODEBOOK_SIZE",
      "type": "int",
      "default": 256,
      "description": "Number of codebook entries",
      "range": { "min": 64, "max": 65536 },
      "units": "entries",
      "required": false
    },
    {
      "name": "CODEBOOK_INDEX_WIDTH",
      "type": "int",
      "default": 8,
      "description": "Width of codebook index",
      "range": { "min": 6, "max": 16 },
      "units": "bits",
      "required": false
    },
    {
      "name": "ADDR_WIDTH",
      "type": "int",
      "default": 12,
      "description": "Width of AXI address bus",
      "range": { "min": 8, "max": 16 },
      "units": "bits",
      "required": false
    },
    {
      "name": "FRACTIONAL_BITS",
      "type": "int",
      "default": 8,
      "description": "Number of fractional bits in fixed-point representation",
      "range": { "min": 4, "max": 16 },
      "units": "bits",
      "required": false
    },
    {
      "name": "PIPELINE_STAGES",
      "type": "int",
      "default": 3,
      "description": "Number of pipeline stages for processing",
      "range": { "min": 1, "max": 8 },
      "units": "stages",
      "required": false
    },
    {
      "name": "CHIPLET_ID",
      "type": "int",
      "default": 0,
      "description": "Unique identifier for chiplet instance",
      "range": { "min": 0, "max": 255 },
      "units": "id",
      "required": false
    },
    {
      "name": "UCIE_LANES",
      "type": "int",
      "default": 16,
      "description": "Number of UCIe lanes for chiplet communication",
      "range": { "min": 4, "max": 64 },
      "units": "lanes",
      "required": false
    },
    {
      "name": "POWER_DOMAINS",
      "type": "int",
      "default": 2,
      "description": "Number of power domains for power management",
      "range": { "min": 1, "max": 8 },
      "units": "domains",
      "required": false
    }
  ],
